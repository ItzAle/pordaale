# Clave de Google Cloud con la API de Google Drive v3 activada.
# Solo se lee en el servidor. No le pongas el prefijo NEXT_PUBLIC_.
GOOGLE_API_KEY=

# ID de la carpeta pública. En la URL es el tramo que va después de /folders/.
# La carpeta tiene que estar compartida como "Cualquier persona con el enlace".
GOOGLE_DRIVE_FOLDER_ID=
